# fast build rule for target.
waypoint_mission/fast:
	$(MAKE) -f waypoint_mission/CMakeFiles/waypoint_mission.dir/build.make waypoint_mission/CMakeFiles/waypoint_mission.dir/build
.PHONY : waypoint_mission/fast

